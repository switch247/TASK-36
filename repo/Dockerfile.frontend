# EXPOSE 8080

# CMD ["dx", "serve", "--platform", "web", "--port", "8080", "--addr", "0.0.0.0"]


# 1. Build Stage
FROM rust:slim-bookworm as builder

# Install minimal build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    pkg-config libssl-dev curl && \
    rm -rf /var/lib/apt/lists/*

# Install Dioxus CLI and WASM target
RUN cargo install dioxus-cli --version 0.7.3 --locked
RUN rustup target add wasm32-unknown-unknown

WORKDIR /usr/src/eagle
COPY . .

# Build the web bundle in release mode.
WORKDIR /usr/src/eagle/frontend
RUN dx bundle --platform web --release
RUN test -f /usr/src/eagle/target/dx/frontend/release/web/public/index.html

# 2. Runtime Stage
FROM nginx:alpine

# Copy the bundled static site into nginx.
COPY --from=builder /usr/src/eagle/target/dx/frontend/release/web/public/ /usr/share/nginx/html/

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
